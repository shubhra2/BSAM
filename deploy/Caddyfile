# BSAM — Caddyfile snippet
# Append this block to /etc/caddy/Caddyfile on the Oracle server.

# ── BSAM — Barber Shop Appointment Manager ────────────────────────────────────
:8080 {
    # Wasp server API routes (operations, auth, health check)
    handle /operations/* {
        reverse_proxy localhost:3001
    }

    handle /auth/* {
        reverse_proxy localhost:3001
    }

    handle / {
        reverse_proxy localhost:3001
    }

    # Static assets (Vite fingerprinted, safe to cache long-term)
    handle /assets/* {
        root * /var/www/bsam
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # SPA fallback — every other route returns 200.html (Wasp's SPA entry)
    handle {
        root * /var/www/bsam
        try_files {path} /200.html
        file_server
    }

    encode gzip zstd
}
